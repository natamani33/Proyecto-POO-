<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LicenseController"
      spacing="20"
      styleClass="page-shell">

    <VBox styleClass="hero-card">
        <Label text="Gestión de Licencias" styleClass="page-title"/>
        <Label text="Registra licencias con el mismo tamaño de campos, una lectura más aireada y controles consistentes."
               wrapText="true"
               styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
        <Label text="Datos de la licencia" styleClass="section-title"/>

        <GridPane styleClass="form-grid">
            <columnConstraints>
                <ColumnConstraints minWidth="130" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                <ColumnConstraints minWidth="130" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
            </columnConstraints>

        <Label text="Servidor *" styleClass="required-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbServer" maxWidth="1.7976931348623157E308"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Tipo licencia *" styleClass="required-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <ComboBox fx:id="cbLicenseType" maxWidth="1.7976931348623157E308"
                  GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Fecha inicio *" styleClass="required-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpStartDate" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Fecha fin *" styleClass="required-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <DatePicker fx:id="dpEndDate" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        </GridPane>

        <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
            <Label text="Licencias registradas" styleClass="section-title"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"       prefWidth="90"/>
                    <TableColumn fx:id="colServer"    text="Servidor" prefWidth="350"/>
                    <TableColumn fx:id="colType"      text="Tipo"     prefWidth="260"/>
                    <TableColumn fx:id="colStartDate" text="Inicio"   prefWidth="160"/>
                    <TableColumn fx:id="colEndDate"   text="Fin"      prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>

        <HBox styleClass="action-bar">
            <Button text="Atrás" onAction="#goBack" styleClass="action-button secondary-button"/>
            <Button text="Guardar" onAction="#save" styleClass="action-button primary-button"/>
            <Button text="Eliminar" onAction="#delete" styleClass="action-button danger-button"/>
        </HBox>
    </VBox>

</VBox>