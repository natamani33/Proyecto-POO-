<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="24"
      styleClass="main-shell">

    <VBox styleClass="hero-card">
        <Label text="Gestión Integrada de Talento Humano" styleClass="page-title"/>
         <Label text="Gobernación de Boyacá"
                 styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="content-card">
        <Label text="Módulos del sistema" styleClass="section-title"/>

        <GridPane styleClass="dashboard-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" fillWidth="true"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" fillWidth="true"/>
            </columnConstraints>

            <Button fx:id="btnServers" text="Servidores Públicos"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="0" GridPane.columnIndex="0"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnPositions" text="Cargos"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnDependencies" text="Dependencias / Secretarías"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="1" GridPane.columnIndex="0"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnEmploymentLinks" text="Vinculación Laboral"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnAdministrativeSituations" text="Situación Administrativa"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="2" GridPane.columnIndex="0"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnVacations" text="Vacaciones"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="2" GridPane.columnIndex="1"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnPermissions" text="Permisos"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="3" GridPane.columnIndex="0"
                    maxWidth="1.7976931348623157E308"/>

            <Button fx:id="btnLicenses" text="Licencias"
                    styleClass="dashboard-button"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"
                    maxWidth="1.7976931348623157E308"/>
        </GridPane>
    </VBox>

</VBox>